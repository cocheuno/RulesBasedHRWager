# Copy to .env (ignored by git) and fill in. Existing environment variables win over this file.
# PuntersEdge API key for the live tote (Phase C). Sent in the X-API-Key header, never logged.
PUNTERSEDGE_API_KEY=your-puntersedge-key-here
# Weather fetch on Desk runs: auto (python-weather for tracks with a location) or off
RACEDESK_WEATHER=auto
# Tote feed: auto (PuntersEdge with the key above) or off
RACEDESK_TOTE=auto
